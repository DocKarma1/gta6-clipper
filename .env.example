# GTA 6 Clipper — environment template
# Copy to .env.local (web) and/or .env (worker). Never commit real secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Auth + database (Supabase Free tier)
# Free projects pause after 1 week of inactivity and include 500 MB database,
# 50k MAU, 1 GB file storage, 5 GB egress. Keep media in R2, not Supabase Storage.
# -----------------------------------------------------------------------------
# Leave these empty for local development. The web app then runs in a clearly
# marked "local development mode" (auth skipped, dashboard routes stay open) and
# the worker uses a gitignored SQLite file in DATA_DIR. This repo never creates
# a Supabase project or user accounts for you.
#
# Exact keys to set when you create your own project (Project Settings → API):
#   NEXT_PUBLIC_SUPABASE_URL          Project URL (https://<ref>.supabase.co)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY     anon / public key
#   SUPABASE_SERVICE_ROLE_KEY         service_role key (server/worker only; never expose in the browser)
#
# Also configure in the Supabase dashboard (not env vars):
#   Authentication → Providers → Email: enable Magic link
#   Authentication → Providers → Twitch: enable, paste a Twitch app Client ID + Secret
#   Authentication → URL Configuration: Site URL = NEXT_PUBLIC_APP_URL
#   Redirect URLs must include {NEXT_PUBLIC_APP_URL}/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Cloudflare R2 (free tier: 10 GB-month, 1M Class A, 10M Class B, $0 egress)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gta6-clipper
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Worker / queue (Redis is meant to run on the same VPS — no hosted Redis bill)
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2
CLIP_MAX_SECONDS=60
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_PYTHON=python3
# Facecam detection uses the same .venv Python and worker/scripts/detect_facecam.py
# (OpenCV YuNet). Install: .venv/bin/pip install -r worker/requirements-python.txt

# Ollama runs on the same PC and writes all AI text (hooks, titles, descriptions,
# hashtags). If it is not running, the worker falls back to built-in templates.
# Default model: llama3.2:3b (~2 GB). Alternatives: qwen2.5:3b (good Swedish),
# llama3.2:1b (low-RAM PCs), qwen2.5:7b / llama3.1:8b (better copy, ~5-6 GB RAM).
# Install: https://ollama.com then `ollama pull llama3.2:3b`.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=20000
# Language for generated text: en | sv
AI_LANGUAGE=en
# (LLM_BASE_URL / LLM_MODEL are still read as aliases of OLLAMA_URL / OLLAMA_MODEL.)

# -----------------------------------------------------------------------------
# QA review gate (worker/src/qa, docs/QA_GATE.md). A rendered clip is "ready"
# only if all four checks pass; otherwise it is "review" with the reasons.
# Only "ready" clips that passed QA can be published. Empty = default.
# -----------------------------------------------------------------------------
# on | off. off = old behaviour (straight to ready) but such clips are unpublishable.
QA_GATE=on
# 1. Highlight: N of 3 signals (speech, audio spike, visual change) must fire.
QA_HIGHLIGHT_MIN_SIGNALS=2
QA_MIN_MEANINGFUL_WORDS=5
QA_MIN_SPEECH_WPS=0.6
QA_MIN_AUDIO_SPIKE_DB=6
QA_MIN_SCENE_SCORE=0.3
QA_MIN_MOTION_SCORE=0.02
# 2. Title: share of title/hook keywords found in the transcript; Ollama yes/no check.
QA_MIN_TITLE_OVERLAP=0.3
QA_OLLAMA_CHECK=on
# 3. Captions
QA_MIN_CAPTION_CUES=2
QA_MAX_CAPTION_LINE_CHARS=32
QA_MAX_CAPTION_LINES=2
QA_MIN_CUE_SECONDS=0.3
QA_MAX_CUE_SECONDS=7
QA_MAX_CAPTION_CPS=25
# 4. Format
QA_MIN_SECONDS=12
QA_MAX_SECONDS=35
QA_WIDTH=1080
QA_HEIGHT=1920

# -----------------------------------------------------------------------------
# Twitch (Helix + chat). Official API, no usage fee. Respect rate-limit headers.
# -----------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional user token if EventSub chat subscriptions require it
TWITCH_USER_ACCESS_TOKEN=
TWITCH_USER_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# YouTube Data API v3 (uploads and metadata)
# Default official quota (as of 12 Nov 2026 docs): 100 videos.insert / day in a
# dedicated bucket (1 unit each), 100 search.list / day, and 10,000 units / day
# for other methods. Older guides that say an upload costs ~1600 units from a
# shared 10k pool (~6 uploads/day) describe the previous model — do not budget
# against that unless Google changes the docs again. Quota increases need an audit.
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# -----------------------------------------------------------------------------
# TikTok Content Posting API
# Unaudited apps can only post privately, to private accounts, for up to 5 users
# per 24 hours. Public posts need TikTok's audit. Do not add watermarks.
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/integrations/tiktok/callback

# -----------------------------------------------------------------------------
# Meta: Instagram Reels + Facebook Reels
# Instagram publishing requires a professional account. Advanced Access needs
# App Review and Business Verification. Facebook Reels publish to Pages only
# (30 API Reels / 24 hours per Page).
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback

# -----------------------------------------------------------------------------
# Payments (Stripe or equivalent)
# Enable only after the web host allows commercial use (not Vercel Hobby).
# Processor fees are per successful charge; there is usually no monthly platform fee.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# -----------------------------------------------------------------------------
# Auto worker (runs on your own PC — see docs/SELF_HOST.md)
# No approval step: the worker clips watchlisted streamers live in GTA VI first,
# then the top-viewer GTA VI streams. Every clip keeps the streamer credit
# overlay. Auto-posting is not implemented; clips are written locally.
# -----------------------------------------------------------------------------
# How many streams to watch. Effective cap = min(AUTO_TOP_K, plan, AUTO_MAX_CONCURRENT).
AUTO_TOP_K=3
AUTO_MAX_CONCURRENT=3
# starter (2 streams) | pro (5) | studio (10) — worker and API enforce these limits.
AUTO_PLAN=starter
AUTO_POLL_MINUTES=2
# Priority watchlist (packages/shared/src/watchlist.ts) first. Set false to use only top viewers.
AUTO_WATCHLIST=true
# Also count watchlisted streamers live in GTA V.
AUTO_INCLUDE_GTA_V=false
# Optional comma-separated language codes, e.g. en,sv
AUTO_LANGUAGES=
# Optional login allow/deny lists (comma-separated, without @)
AUTO_ALLOW_LIST=
AUTO_DENY_LIST=
AUTO_WRITE_LOCAL_ONLY=true
# Capture: streamlink quality order, segment length and rolling buffer.
AUTO_STREAM_QUALITY=1080p60,1080p,936p60,720p60,720p,best
AUTO_SEGMENT_SECONDS=6
AUTO_BUFFER_SECONDS=150
# Clip window around a highlight (seconds). Chat lags video by ~AUTO_CHAT_DELAY_SECONDS.
AUTO_PRE_ROLL_SECONDS=10
AUTO_POST_ROLL_SECONDS=5
AUTO_MIN_CLIP_SECONDS=15
AUTO_MAX_CLIP_SECONDS=45
AUTO_CHAT_DELAY_SECONDS=3
AUTO_COOLDOWN_SECONDS=45
# Spoken questions: transcribe the newest audio of one stream every N seconds
# (round-robin, faster-whisper). 0 disables the speech sampler.
AUTO_SPEECH_QUESTION_SECONDS=30
AUTO_SPEECH_MODEL=tiny
# Renders at once (keep 1 on a normal PC) and whether to keep the raw cut.
AUTO_RENDER_CONCURRENCY=1
AUTO_KEEP_RAW=false
# Optional: write clips to this folder instead of DATA_DIR/clips (/queue serves it too).
AUTO_SAMPLE_DIR=
# Write clips to Supabase instead of local SQLite (needs SUPABASE_SERVICE_ROLE_KEY).
AUTO_WORKSPACE_ID=
# Optional: stop the worker after N seconds (useful for a timed test run)
AUTO_RUN_SECONDS=

# Render quality (libx264). CRF 18-20 is visually clean; preset medium is a good
# PC default (slow = smaller files, more CPU). Loudness target in LUFS.
RENDER_PRESET=medium
RENDER_CRF=19
RENDER_TARGET_LUFS=-14
DATA_DIR=./data
STREAMLINK_PATH=

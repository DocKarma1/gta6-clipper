# GTA 6 Clipper — environment template
# Copy to .env.local (web) and/or .env (worker). Never commit real secrets.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Auth + database (Supabase Free tier)
# Free projects pause after 1 week of inactivity and include 500 MB database,
# 50k MAU, 1 GB file storage, 5 GB egress. Keep media in R2, not Supabase Storage.
# -----------------------------------------------------------------------------
# Leave these empty for local development. The web app then runs in a clearly
# marked "local development mode" (auth skipped, dashboard routes stay open) and
# the worker uses a gitignored SQLite file in DATA_DIR. This repo never creates
# a Supabase project or user accounts for you.
#
# Exact keys to set when you create your own project (Project Settings → API):
#   NEXT_PUBLIC_SUPABASE_URL          Project URL (https://<ref>.supabase.co)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY     anon / public key
#   SUPABASE_SERVICE_ROLE_KEY         service_role key (server/worker only; never expose in the browser)
#
# Also configure in the Supabase dashboard (not env vars):
#   Authentication → Providers → Email: enable Magic link
#   Authentication → Providers → Twitch: enable, paste a Twitch app Client ID + Secret
#   Authentication → URL Configuration: Site URL = NEXT_PUBLIC_APP_URL
#   Redirect URLs must include {NEXT_PUBLIC_APP_URL}/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Cloudflare R2 (free tier: 10 GB-month, 1M Class A, 10M Class B, $0 egress)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gta6-clipper
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Worker / queue (Redis is meant to run on the same VPS — no hosted Redis bill)
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=2
CLIP_MAX_SECONDS=60
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_PYTHON=python3

# Local LLM for titles/hashtags (Ollama or compatible). Leave empty to skip.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2

# Optional free-tier LLM fallbacks. Leave blank if unused. Do not make a paid
# API the default path.
GROQ_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Twitch (Helix + chat). Official API, no usage fee. Respect rate-limit headers.
# -----------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional user token if EventSub chat subscriptions require it
TWITCH_USER_ACCESS_TOKEN=
TWITCH_USER_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# YouTube Data API v3 (uploads and metadata)
# Default official quota (as of 12 Nov 2026 docs): 100 videos.insert / day in a
# dedicated bucket (1 unit each), 100 search.list / day, and 10,000 units / day
# for other methods. Older guides that say an upload costs ~1600 units from a
# shared 10k pool (~6 uploads/day) describe the previous model — do not budget
# against that unless Google changes the docs again. Quota increases need an audit.
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/integrations/youtube/callback

# -----------------------------------------------------------------------------
# TikTok Content Posting API
# Unaudited apps can only post privately, to private accounts, for up to 5 users
# per 24 hours. Public posts need TikTok's audit. Do not add watermarks.
# -----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/integrations/tiktok/callback

# -----------------------------------------------------------------------------
# Meta: Instagram Reels + Facebook Reels
# Instagram publishing requires a professional account. Advanced Access needs
# App Review and Business Verification. Facebook Reels publish to Pages only
# (30 API Reels / 24 hours per Page).
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback

# -----------------------------------------------------------------------------
# Payments (Stripe or equivalent)
# Enable only after the web host allows commercial use (not Vercel Hobby).
# Processor fees are per successful charge; there is usually no monthly platform fee.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# -----------------------------------------------------------------------------
# Auto worker (discovery, chat spikes, local clipping)
# requirePermission defaults to true. Only channels in AUTO_PERMITTED_CHANNELS
# are watched unless you explicitly set AUTO_REQUIRE_PERMISSION=false for a
# local test run. Auto-posting is not implemented; clips are written locally.
# -----------------------------------------------------------------------------
AUTO_TOP_K=3
# starter | pro | studio — worker and API enforce these limits. Default starter.
AUTO_PLAN=starter
AUTO_POLL_MINUTES=2
# Optional comma-separated language codes, e.g. en,sv
AUTO_LANGUAGES=
# Optional login allow/deny lists (comma-separated, without @)
AUTO_ALLOW_LIST=
AUTO_DENY_LIST=
AUTO_REQUIRE_PERMISSION=true
AUTO_PERMITTED_CHANNELS=
AUTO_WRITE_LOCAL_ONLY=true
AUTO_SEGMENT_SECONDS=10
AUTO_BUFFER_SECONDS=120
AUTO_PRE_ROLL_SECONDS=20
AUTO_POST_ROLL_SECONDS=10
AUTO_COOLDOWN_SECONDS=60
# Optional: stop the worker after N seconds (useful for a timed test run)
AUTO_RUN_SECONDS=
DATA_DIR=./data
STREAMLINK_PATH=
